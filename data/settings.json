{
  "version": 1,
  "settings": {
    "history_enabled": true,
    "retention_days": 7,
    "max_mb": 100,
    "recorded_sensors": [
      "cpu.total",
      "cpu.frequency.current",
      "cpu.frequency.max",
      "cpu.throttling.estimated",
      "memory.used",
      "storage.disk.read",
      "storage.disk.write",
      "network.receive",
      "network.send",
      "battery.charge",
      "battery.power_plugged",
      "battery.seconds_left",
      "battery.voltage",
      "gpu.3d.utilization",
      "thermal.wmi.acpi-zone.0",
      "storage.temperature.disk0.sensor0"
    ],
    "refresh_interval_seconds": 3,
    "theme": "dark",
    "online_device_fact_lookup": true
  }
}
